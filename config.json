{
  "input_sources": [
    "crm_customers.json",
    "orders.csv",
    "support_tickets.xml"
  ],
  "as_of_date": "2026-10-28",
  "paths": {
    "raw_dir": "data/raw",
    "output_dir": "output",
    "latest_dir_name": "latest",
    "log_file": "output/pipeline.log",
    "qa_log_file": "output/qa_log.jsonl"
  },
  "sources": {
    "crm_customers.json": {
      "system": "crm",
      "field_map": {
        "customer_id": "customer_id",
        "name": "name",
        "email": "email",
        "city": "city",
        "registration_date": "registration_date"
      }
    },
    "orders.csv": {
      "system": "orders",
      "field_map": {
        "cust_id": "customer_id",
        "total_orders": "total_orders",
        "lifetime_value": "lifetime_value",
        "last_order_date": "last_order_date"
      }
    },
    "support_tickets.xml": {
      "system": "support",
      "record_tag": "customer",
      "field_map": {
        "customerId": "customer_id",
        "tickets": "support_tickets",
        "lastTicketDate": "last_ticket_date"
      }
    }
  },
  "validation": {
    "id_regex": "^C\\d{4}$",
    "email_regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
    "date_format": "%Y-%m-%d",
    "mandatory_fields": ["name", "city", "registration_date"],
    "max_reject_rate": 0.05,
    "rules": {
      "EMPTY_ID":               {"action": "reject", "severity": "error"},
      "BAD_ID":                 {"action": "reject", "severity": "error"},
      "DUP_ID":                 {"action": "reject", "severity": "error"},
      "BAD_EMAIL":              {"action": "null_and_flag", "severity": "error"},
      "MISSING_FIELD":          {"action": "reject", "severity": "error"},
      "NULL_ORDERS":            {"action": "flag", "severity": "error"},
      "NULL_TICKETS":           {"action": "flag", "severity": "error"},
      "NEG_REVENUE":            {"action": "null_and_quarantine", "severity": "error"},
      "BAD_NUMBER":             {"action": "null_and_flag", "severity": "error"},
      "BAD_DATE_UNPARSEABLE":   {"action": "null_and_flag", "severity": "error"},
      "BAD_DATE_FUTURE":        {"action": "flag", "severity": "error"},
      "ORPHAN":                 {"action": "reject", "severity": "error"},
      "DUP_EMAIL":              {"action": "flag", "severity": "warning"},
      "CROSS_DATE":             {"action": "flag", "severity": "warning"},
      "ZERO_TICKETS_WITH_DATE": {"action": "flag", "severity": "warning"},
      "NULL_DATE":              {"action": "flag", "severity": "warning"},
      "NO_ORDER_ROW":           {"action": "flag", "severity": "warning"},
      "NO_TICKET_ROW":          {"action": "flag", "severity": "warning"}
    }
  },
  "merge": {
    "missing_row_defaults": {
      "total_orders": 0,
      "lifetime_value": 0,
      "support_tickets": 0
    }
  },
  "segments": {
    "mode": "fixed",
    "gold_min_exclusive": 100000,
    "silver_min_inclusive": 50000,
    "percentile_cuts": [0.3333, 0.6667],
    "null_label": "Unknown"
  },
  "support": {
    "high_ticket_threshold": 5,
    "default_percentile": 0.75,
    "report_percentiles": [0.25, 0.5, 0.75, 0.9]
  },
  "risk": {
    "weights": {
      "order_recency": 0.40,
      "ticket_count": 0.30,
      "ticket_recency": 0.20,
      "low_ltv": 0.10
    },
    "order_recency_cap_days": 180,
    "ticket_count_cap": 12,
    "ticket_recency_window_days": 90,
    "band_medium_min": 40,
    "band_high_min": 65
  },
  "rfm": {
    "bins": 5,
    "rules": [
      {"label": "Champions", "all": {"r_min": 4, "f_min": 4, "m_min": 4}},
      {"label": "At Risk", "all": {"r_max": 2}, "any": {"f_min": 3, "m_min": 3}},
      {"label": "Dormant", "all": {"r_max": 2}},
      {"label": "Loyal", "all": {"f_min": 4}},
      {"label": "Big Spenders", "all": {"m_min": 4}}
    ],
    "default_label": "Needs Attention",
    "unscored_label": "Unscored"
  },
  "llm": {
    "provider": "groq",
    "model": "openai/gpt-oss-120b",
    "fallback_model": "openai/gpt-oss-20b",
    "api_key_env": "GROQ_API_KEY",
    "reasoning_effort": "low",
    "timeout_seconds": 20,
    "max_retry_wait_seconds": 10,
    "sql_timeout_seconds": 5,
    "temperature": 0,
    "max_result_rows": 200,
    "max_summary_rows": 20,
    "hidden_columns": ["email"],
    "summary_excluded_columns": ["name", "email"],
    "allowed_tables": ["customer_360", "rejected_records"],
    "schema_doc": "src/qa/schema_doc.json"
  }
}
